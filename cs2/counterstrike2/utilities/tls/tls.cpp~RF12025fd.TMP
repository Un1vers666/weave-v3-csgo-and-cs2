    for (const auto& it : const_pattern) {
        auto address = g_utils->pattern_scan(std::uintptr_t(GetModuleHandleA(it.module.c_str())), it.pattern.c_str());

        std::uint64_t offset = 0;
        if (it.relative)
            offset = address.add(it.offset).relative_address().get();
        else
            offset = address.get();

        patterns.push_back(offset);
        patternResults.emplace_back(offset, it.debug_info);

class KeyValues3
{
public:
    char pad[0x100]{};
};

struct KV3ID_t
{
    const char* name;
    std::uint64_t key;
    std::uint64_t key2;
};

enum kv_basic_type : uint8_t
{
    kv_basic_invalid,
    kv_basic_null,
    kv_basic_bool,
    kv_basic_int,
    kv_basic_uint,
    kv_basic_double,
    kv_basic_string,
    kv_basic_binary_blob,
    kv_basic_array,
    kv_basic_table
};

enum kv_field_type_t : uint8_t
{
    kv_field_invalid,
    kv_field_resource,
    kv_field_resource_name,
    kv_field_panorama,
    kv_field_soundevent,
    kv_field_subclass,
    kv_field_unspecified,
    kv_field_null,
    kv_field_binary_blob,
    kv_field_array,
    kv_field_table,
    kv_field_bool8,
    kv_field_char8,
    kv_field_uchar32,
    kv_field_int8,
    kv_field_uint8,
    kv_field_int16,
    kv_field_uint16,
    kv_field_int32,
    kv_field_uint32,
    kv_field_int64,
    kv_field_uint64,
    kv_field_float32,
    kv_field_float64,
    kv_field_string,
    kv_field_pointer,
    kv_field_color32,
    kv_field_vector,
    kv_field_vector2d,
    kv_field_vector4d,
    kv_field_rotation_vector,
    kv_field_quaternion,
    kv_field_qangle,
    kv_field_matrix3x4,
    kv_field_transform,
    kv_field_string_token,
    kv_field_ehandle
};

//void set_type(KeyValues3* kv3, int type, int type2)
//{
//    using function_t = void(__fastcall*)(KeyValues3* kv3, int, int);
//    g_cs2->m_patterns[FNV32("get_type")].as<function_t>()(kv3, type, type2);
//}

void set_type(KeyValues3* kv3, int type, int type2)
{
    using function_t = void(__fastcall*)(KeyValues3* kv3, int, int);
    g_utils->pattern_scan(g_cs2->m_module_system.get_client(), "40 53 48 83 EC 20 48 8B 01 48 8B D9 44").as<function_t>()(kv3, type, type2);
}

bool LoadKV3(KeyValues3* kv3, std::uintptr_t* string, const char* buffer, const KV3ID_t* kv3_id, char* unk_string)
{
    using function_t = bool(__fastcall*)(KeyValues3* kv3, std::uintptr_t* string, const char* buffer, const KV3ID_t* kv3_id, char* unk_strin);
    return g_cs2->m_patterns[FNV32("load_kv3")].as<function_t>()(kv3, string, buffer, kv3_id, unk_string);
}

i_material* c_chams::create_material(const char* vmat)
{

    KeyValues3 kv3;
    set_type(&kv3, kv_basic_type::kv_basic_null, kv_basic_type::kv_basic_string);

    // materialsystem + 0x00000001800C6308
    KV3ID_t kv3_id;
    kv3_id.name = xorstr_("generic");
    kv3_id.key = 0x469806E97412167C;
    kv3_id.key2 = 0x0E73790B53EE6F2AF;

    if (!LoadKV3(&kv3, nullptr, vmat, &kv3_id, nullptr))
        return nullptr;

    i_material** custom_material;

    // "materialsystem2.dll", "48 89 5C 24 08 48 89 6C 24 18 56 57 41 56 48

    static auto crm = g_utils->pattern_scan(g_cs2->m_module_system.get_materialsystem2(), "48 89 5C 24 08 48 89 6C 24 18 56 57 41 56 48");

    crm.as<void(__fastcall*)(std::uintptr_t*, i_material***, const char*, KeyValues3*, int, std::uint8_t)>()(nullptr, &custom_material, "weave", &kv3, 0, 1);

    return *custom_material;
}

bool ran_once = false;

i_material* c_chams::reconstruct_material(i_material* mat) {
    //L_PRINT(LOG_INFO) << "reconstructing material: " << mat->GetName();
    if (mat->find_parameter("g_tColorA")) {
        std::string _template = R"#(<!-- kv3 encoding:text:version{e21c7f3c-8a33-41c5-9977-a76d3a32aa0d}
			format:generic:version{7412167c-06e9-4698-aff2-e63eb59037e7} -->
			{
                shader = "csgo_simple_2way_blend.vfx"
                g_tColorA = resource:"materials/dev/primary_white_color_tga_21186c76.vtex"
                g_tColorB = resource:"materials/dev/primary_white_color_tga_21186c76.vtex"
                g_tNormalA = resource:"materials/default/default_normal_tga_7652cb.vtex"
                g_tNormalB = resource:"materials/default/default_normal_tga_7652cb.vtex"
                g_tRoughness = resource:"materials/default/default_normal_tga_b3f4ec4c.vtex"
                g_tMetalness = resource:"materials/default/default_normal_tga_b3f4ec4c.vtex"
                g_tAmbientOcclusion = resource:"materials/default/default_normal_tga_b3f4ec4c.vtex"
                F_IGNOREZ = 0
                F_DISABLE_Z_WRITE = 0
                F_DISABLE_Z_BUFFERING = 0
                F_RENDER_BACKFACES = 1
                g_vColorTint = [1.0, 1.0, 1.0, 1.0]
			} )#";

        i_material* material = create_material(_template.c_str());
        if (!material) {
            //L_PRINT(LOG_ERROR) << "Failed to reconstruct 2way blend material " << mat->GetName();
            return nullptr;
        }

        if (mat->find_parameter("g_tColorA"))     material->find_parameter("g_tColorA")->texture_value = mat->find_parameter("g_tColorA")->texture_value;
        if (mat->find_parameter("g_tColorB"))     material->find_parameter("g_tColorB")->texture_value = mat->find_parameter("g_tColorB")->texture_value;
        if (mat->find_parameter("g_tNormalA"))    material->find_parameter("g_tNormalA")->texture_value = mat->find_parameter("g_tNormalA")->texture_value;
        if (mat->find_parameter("g_tNormalB"))    material->find_parameter("g_tNormalB")->texture_value = mat->find_parameter("g_tNormalB")->texture_value;

        return material;
    }
    else {
        std::string _template = R"#(<!-- kv3 encoding:text:version{e21c7f3c-8a33-41c5-9977-a76d3a32aa0d}
			format:generic:version{7412167c-06e9-4698-aff2-e63eb59037e7} -->
			{
                shader = "generic.vfx"
                g_tColor = resource:"materials/dev/primary_white_color_tga_21186c76.vtex"
                g_tNormal = resource:"materials/default/default_normal_tga_7652cb.vtex"
                g_tRoughness = resource:"materials/default/default_normal_tga_b3f4ec4c.vtex"
                g_tMetalness = resource:"materials/default/default_normal_tga_b3f4ec4c.vtex"
                g_tAmbientOcclusion = resource:"materials/default/default_normal_tga_b3f4ec4c.vtex"
                F_IGNOREZ = 0
                F_DISABLE_Z_WRITE = 0
                F_DISABLE_Z_BUFFERING = 0
                F_RENDER_BACKFACES = 1
                g_vColorTint = [1.0, 1.0, 1.0, 1.0]
			} )#";

        i_material* material = create_material(_template.c_str());
        if (!material) {
           // L_PRINT(LOG_ERROR) << "Failed to recreate material " << mat->GetName();
            return nullptr;
        }

        if (mat->find_parameter("g_tColor"))     material->find_parameter("g_tColor")->texture_value = mat->find_parameter("g_tColor")->texture_value;
        if (mat->find_parameter("g_tNormal"))    material->find_parameter("g_tNormal")->texture_value = mat->find_parameter("g_tNormal")->texture_value;

        return material;
    }
}

void c_chams::sky_color_changer() {

    if (!g_user->IsActive(xorstr_("misc_skybox"), xorstr_("misc_skybox"), 0))
        return;

    static color_t currentColor{ 69, 69, 69 };
    static uint64_t oldArrCount = 0;
    resource_array_t arr{};

    arr.m_nCount = 0;
    arr.m_aResources = nullptr;
    Interfaces::resource_system->enumerate_material(0x74616D76, &arr, 2);

    color_t targetColor{ 0, 0, 0 };
    color_t skybox_color(g_user->GetConfig()["misc_skybox_color"]);
    if (!g_user->IsActive(xorstr_("misc_skybox"), xorstr_("misc_skybox"), 0))
        targetColor = { 255, 255, 255 };
    else
        targetColor = skybox_color;

    if (targetColor == currentColor && oldArrCount == arr.m_nCount)
        return;

    if (!arr.m_nCount)
        return;

    oldArrCount = arr.m_nCount;
    currentColor = targetColor;

    for (int i = 0; i < arr.m_nCount; i++) {

        i_material** pmat = arr.m_aResources[i];

        if (!pmat)
            continue;

        i_material* mat = *pmat;
        if (!mat)
            continue;

        std::string name = mat->get_name();

        // Process only skybox materials
        if (name.find("skybox") != std::string::npos || name.find("sky") != std::string::npos) {

            material_paramater* param = mat->find_parameter("g_vColorTint");

            if (!param) continue;

            if (mat->find_parameter("F_NOTINT") || mat->find_parameter("g_tTintMask")) {
                // Recreate the material if it has tint mask or notint parameters
                i_material* material = reconstruct_material(mat);
                *pmat = material;
                mat = material;
                param = material->find_parameter("g_vColorTint");
            }

            param->vec_value = vector_4d{ targetColor.get_red() / 255.f, targetColor.get_green() / 255.f, targetColor.get_blue() / 255.f, 1.f };
            mat->update_parameter();
        }
    }
}


void c_chams::world_color_changer() {
    static color_t currentColor{ 69, 69, 69 };
    static uint64_t oldArrCount = 0;
    resource_array_t arr{};

    arr.m_nCount = 0;
    arr.m_aResources = nullptr;
    Interfaces::resource_system->enumerate_material(0x74616D76, &arr, 2);

    color_t targetColor{ 0, 0, 0 };
    color_t world_color(g_user->GetConfig()["misc_world_color"]);
    if (!g_user->IsActive(xorstr_("misc_world"), xorstr_("misc_world"), 0))
        targetColor = { 255, 255, 255 };
    else
        targetColor = world_color;

    if (targetColor == currentColor && oldArrCount == arr.m_nCount)
        return;

    if (!arr.m_nCount)
        return;

    oldArrCount = arr.m_nCount;
    currentColor = targetColor;

    for (int i = 0; i < arr.m_nCount; i++) {

        i_material** pmat = arr.m_aResources[i];

        if (!pmat)
            continue;

        i_material* mat = *pmat;
        if (!mat)
            continue;

        std::string name = mat->get_name();

        if (name.find("char") != std::string::npos)
            continue;

        if (name.find("weapons") != std::string::npos)
            continue;

        if (name.find("weapon") != std::string::npos)
            continue;

        if (name.find("gun") != std::string::npos)
            continue;

        if (name.find("inventory") != std::string::npos)
            continue;

        if (name.find("skin") != std::string::npos)
            continue;

        if (name.find("plane") != std::string::npos)
            continue;

        if (name.find("luggage") != std::string::npos)
            continue;

        if (name.find("suitcase") != std::string::npos)
            continue;

        material_paramater* param = mat->find_parameter("g_vColorTint");

        if (!param) continue;

        if (mat->find_parameter("F_NOTINT") || mat->find_parameter("g_tTintMask")) {
            // we need to recreate the material here because a material with tint mask and / or notint is just unaccaptable
            i_material* material = reconstruct_material(mat);
            *pmat = material;
            mat = material;
            param = material->find_parameter("g_vColorTint");
        }

        param->vec_value = vector_4d{ targetColor.get_red() / 255.f, targetColor.get_green() / 255.f, targetColor.get_blue() / 255.f, 1.f };
        mat->update_parameter();
    }
}

void c_chams::fsn(int stage) {
    if (stage == 6) {
        world_color_changer();
    }
}

